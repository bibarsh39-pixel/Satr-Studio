#include <windows.h>
1 RT_MANIFEST "Satr.manifest"
IDI_ICON1 ICON "Satr.ico"
1 VERSIONINFO
 FILEVERSION 0,9,0,0
 PRODUCTVERSION 0,9,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Satr Studio"
   VALUE "FileDescription", "Satr Studio - Code Editor"
   VALUE "FileVersion", "0.9.0"
   VALUE "InternalName", "Satr"
   VALUE "OriginalFilename", "Satr.exe"
   VALUE "ProductName", "Satr Studio"
   VALUE "ProductVersion", "0.9.0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
